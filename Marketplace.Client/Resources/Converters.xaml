<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Marketplace.Client.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:RatingConverter x:Key="Rating" />
    <conv:ImageNameConverter x:Key="ImageName" />
    <conv:EmptyListToVisibilityConverter x:Key="EmptyListToVisibility" />
    <conv:LocalTimeConverter x:Key="LocalTime" />

</ResourceDictionary>
