<Window x:Class="Marketplace.Client.Views.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Регистрация" Style="{StaticResource HeaderText}" />

        <TextBlock Text="Логин" Style="{StaticResource MutedText}" />
        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Пароль" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        <PasswordBox PasswordChanged="OnPasswordChanged" />

        <TextBlock Text="Повторите пароль" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        <PasswordBox PasswordChanged="OnRepeatPasswordChanged" />

        <TextBlock Text="Если вы уже регистрировались, просто введите свой логин и пароль, и мы выполним вход."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" />

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True" />
            <Button Content="Зарегистрироваться" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>
    </StackPanel>
</Window>
