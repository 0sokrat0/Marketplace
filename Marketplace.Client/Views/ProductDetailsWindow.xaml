<Window x:Class="Marketplace.Client.Views.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Product.Name}" Width="780" Height="700" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}">
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0" Height="210" VerticalAlignment="Top">
                <Image Source="{Binding Product.ImageFileName, Converter={StaticResource ImageName}}" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock Text="{Binding Product.Name}" Style="{StaticResource HeaderText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Product.CategoryName}" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding Product.Price, StringFormat={}{0:N2} ₽}" FontSize="24" FontWeight="Bold" Margin="0,8" />
                <TextBlock Text="{Binding Product.Description}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Product.PackSize, StringFormat=В упаковке: {0} шт.}" Margin="0,6,0,0"
                           Visibility="{Binding Product.PackSize, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding Product.Stock, StringFormat=На складе: {0} шт.}" Margin="0,2,0,0" />
                <TextBlock Margin="0,2,0,0">
                    <Run Text="{Binding Product.AverageRating, Converter={StaticResource Rating}, Mode=OneWay}" />
                    <Run Text="{Binding Product.ReviewCount, StringFormat=({0} отзывов), Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
                <TextBlock Text="Недоступно для покупки" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Product.CanBuy}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding ShowShopButtons, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="В корзину" Style="{StaticResource PrimaryButton}" Margin="0,4,4,4"
                            IsEnabled="{Binding Product.CanBuy}" Command="{Binding AddToCartCommand}" />
                    <Button Content="В избранное" Command="{Binding AddToFavoritesCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="4"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="4"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0"
                Visibility="{Binding Session.IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Ваш отзыв" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Оценка:" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding RatingOptions}" SelectedItem="{Binding NewRating}" Width="70" />
                </StackPanel>
                <TextBox Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="54" MaxLength="1000" />
                <Button Content="Отправить" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        Command="{Binding SubmitReviewCommand}" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="Отзывы" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,6" />
        <ListBox ItemsSource="{Binding Reviews}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UserLogin}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Rating, StringFormat=  ★ {0}}" />
                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}"
                                       Style="{StaticResource MutedText}" Margin="12,0,0,0" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                   Visibility="{Binding Text, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
