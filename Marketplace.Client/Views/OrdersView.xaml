<UserControl x:Class="Marketplace.Client.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Мои заказы" Style="{StaticResource HeaderText}" />

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="6,4"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Text="Заказов пока нет" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" DockPanel.Dock="Top"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,10,0">
                <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          DisplayMemberPath="Title" />
                <ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat={}{0:N2} ₽}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Id, StringFormat=Заказ №{0}}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}"
                                           Style="{StaticResource MutedText}" FontSize="12" />
                                <TextBlock Text="{Binding Status}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0"
                    Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Details.Id, StringFormat=Заказ №{0}}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0">
                            <Run Text="Статус: " Foreground="{StaticResource MutedBrush}" />
                            <Run Text="{Binding Details.Status, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Оформлен: " Foreground="{StaticResource MutedBrush}" />
                            <Run Text="{Binding Details.CreatedAt, Converter={StaticResource LocalTime}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="{Binding Details.DeliveryMethod, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=": " />
                            <Run Text="{Binding Details.Destination, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Details.Total, StringFormat=Итого: {0:N2} ₽}"
                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,10,0,0" />
                    <DataGrid ItemsSource="{Binding Details.Items}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:N2} ₽}" Width="100" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat={}{0:N2} ₽}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
