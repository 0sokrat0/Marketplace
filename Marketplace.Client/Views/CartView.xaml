<UserControl x:Class="Marketplace.Client.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Корзина" Style="{StaticResource HeaderText}" />

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="6,4"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="6,4"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Оформить заказ" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CheckoutCommand}" />
                <TextBlock Text="{Binding Total, StringFormat=Итого: {0:N2} ₽}" FontSize="20" FontWeight="Bold" />
            </DockPanel>
        </Border>

        <TextBlock Text="В корзине пока ничего нет" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" DockPanel.Dock="Top"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding ImageFileName, Converter={StaticResource ImageName}}"
                                       Width="60" Height="60" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="Сейчас недоступно для покупки" Foreground="{StaticResource DangerBrush}"
                                               FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanBuy}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="−" Width="34" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <TextBlock Text="{Binding Quantity}" Width="34" TextAlignment="Center" FontWeight="SemiBold" />
                                    <Button Content="+" Width="34" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2} ₽}"
                                           FontWeight="Bold" TextAlignment="Right" />
                                <Button Grid.Column="4" Content="Удалить" Style="{StaticResource DangerButton}"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
