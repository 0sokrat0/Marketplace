<UserControl x:Class="Marketplace.Client.Views.AdminOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Заказы пользователей" Style="{StaticResource HeaderText}" />

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="6,4"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="6,4"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding UserLogin}" Width="110" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                    <DataGridTextColumn Header="Получение" Binding="{Binding DeliveryMethod}" Width="90" />
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:N2} ₽}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0"
                    Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Details.Id, StringFormat=Заказ №{0}}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Details.UserLogin, StringFormat=Пользователь: {0}}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Details.CreatedAt, Converter={StaticResource LocalTime}}"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,10">
                            <Run Text="{Binding Details.DeliveryMethod, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=": " />
                            <Run Text="{Binding Details.Destination, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Details.Total, StringFormat=Итого: {0:N2} ₽}" FontSize="18"
                                   FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Text="Статус заказа" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" />
                        <Button Content="Применить статус" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                Command="{Binding ApplyStatusCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Details.Items}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat={}{0:N2} ₽}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
