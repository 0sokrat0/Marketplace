<UserControl x:Class="Marketplace.Client.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <TextBlock Text="Добро пожаловать в маркетплейс" Style="{StaticResource HeaderText}" TextWrapping="Wrap" />
        <TextBlock Text="Каталог доступен всем: можно искать товары, фильтровать их и читать отзывы."
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="Чтобы пользоваться корзиной и избранным, оформлять заказы и оставлять отзывы, войдите в аккаунт или зарегистрируйтесь."
                   TextWrapping="Wrap" Style="{StaticResource MutedText}"
                   Visibility="{Binding Session.IsAuthenticated, Converter={StaticResource InverseBoolToVisibility}}" />
    </StackPanel>
</UserControl>
