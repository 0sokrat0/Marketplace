<Window x:Class="Marketplace.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Вход в аккаунт" Style="{StaticResource HeaderText}" />

        <TextBlock Text="Логин" Style="{StaticResource MutedText}" />
        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Пароль" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        <PasswordBox PasswordChanged="OnPasswordChanged" />

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True" />
            <Button Content="Войти" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SignInCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>
    </StackPanel>
</Window>
