<UserControl x:Class="Marketplace.Client.Views.AdminReviewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Модерация отзывов" Style="{StaticResource HeaderText}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Товар:" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name"
                      Width="320" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="6,4"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="6,4"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
            <Button Content="Удалить выбранный отзыв" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                    Command="{Binding DeleteCommand}" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Reviews}" SelectedItem="{Binding SelectedReview}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UserLogin}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Rating, StringFormat=  ★ {0}}" />
                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}"
                                       Style="{StaticResource MutedText}" Margin="12,0,0,0" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
