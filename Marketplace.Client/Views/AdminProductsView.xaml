<UserControl x:Class="Marketplace.Client.Views.AdminProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Управление товарами" Style="{StaticResource HeaderText}" />

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="6,4"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="6,4"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="120" />
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="100" />
                    <DataGridTextColumn Header="Склад" Binding="{Binding Stock}" Width="60" />
                    <DataGridCheckBoxColumn Header="Доступен" Binding="{Binding IsAvailable, Mode=OneWay}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Название" Style="{StaticResource MutedText}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Описание" Style="{StaticResource MutedText}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="60" />
                        <TextBlock Text="Категория" Style="{StaticResource MutedText}" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Цена, ₽" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="На складе" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Штук в упаковке (если нужно)" Style="{StaticResource MutedText}" />
                        <TextBox Text="{Binding PackSizeText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Файл изображения" Style="{StaticResource MutedText}" />
                        <TextBox Text="{Binding ImageFileName, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Доступен для покупки" IsChecked="{Binding IsAvailable}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Новый товар" Command="{Binding NewCommand}" />
                            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
