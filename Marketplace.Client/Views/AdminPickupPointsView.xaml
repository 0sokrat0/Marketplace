<UserControl x:Class="Marketplace.Client.Views.AdminPickupPointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Пункты выдачи" Style="{StaticResource HeaderText}" />

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="6,4"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="6,4"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Название" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Адрес" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="50"
                             AcceptsReturn="True" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Удалить" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                        <Button Content="Новый" Command="{Binding NewCommand}" />
                        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
